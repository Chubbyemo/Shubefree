{
  "schemaVersion": 1,
  "name": "Chubby Mouse",
  "author": "Chubbyemo",
  "version": "2.0.0",
  "description": "Chubbyemo's little gray mouse as pixel art — every animation is one of her drawings",
  "viewBox": {
    "x": -12,
    "y": -24,
    "width": 52,
    "height": 52
  },
  "layout": {
